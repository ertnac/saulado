# Local Postgres from docker-compose.yml at the repo root.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saulado?schema=public"

PORT=3000
NODE_ENV=development

# Comma-separated origin allowlist for CORS.
CORS_ORIGIN="http://localhost:5173"

# ── Auth ────────────────────────────────────────────────────────────────────
# Signing key for access tokens. Minimum 32 characters; no default is provided
# because a secret committed to the repo is not a secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev-only-insecure-secret-replace-me-in-any-real-deployment"

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=60

# bcrypt cost factor. Plan requires >= 12. Raise for production hardware.
BCRYPT_ROUNDS=12

# Refresh-cookie SameSite policy: strict | lax | none
# Leave unset to get the right default per environment — `lax` in development
# (the Vite proxy makes the browser same-origin) and `none` in production, which
# is required because the Vercel frontend and Render API are different sites and
# a Lax cookie would never be sent on /api/auth/refresh.
# COOKIE_SAMESITE=lax

# Set only when the API and frontend share a parent domain (e.g. ".saulado.app").
# COOKIE_DOMAIN=

# Public origin of the frontend. Password reset links are built from this.
APP_URL="http://localhost:5173"

# ── Email ───────────────────────────────────────────────────────────────────
# Unset: reset emails are written to the server log, and the reset link is
# printed there. The whole password-reset flow works locally with no provider
# account. Set this to send real mail via Resend instead.
# RESEND_API_KEY=
EMAIL_FROM="Saulado <onboarding@resend.dev>"
