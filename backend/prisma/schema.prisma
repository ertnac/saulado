// Phase 2 adds auth. Phase 3 adds sets/cards/answers per IMPLEMENTATION_PLAN.md
// §2.3; scheduling tables arrive in Phase 4.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // btree_gist backs the no-overlapping-answers EXCLUDE constraint added by raw
  // SQL in the sets/cards migration; it lets one constraint mix `card_id WITH =`
  // (btree semantics) and a range `WITH &&` (gist semantics).
  extensions = [citext, btree_gist]
}

model HealthCheck {
  id        String   @id @default(uuid()) @db.Uuid
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("health_checks")
}

/// Email is CITEXT so uniqueness is case-insensitive in the database itself.
/// Normalising in application code alone is not enough: two concurrent
/// registrations can both pass a SELECT-then-INSERT check and produce
/// `A@x.com` and `a@x.com` as separate accounts. The constraint is the control.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.Citext
  passwordHash    String    @map("password_hash")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  emailVerifiedAt DateTime? @map("email_verified_at")

  settings       UserSettings?
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  studySets      StudySet[]

  @@map("users")
}

/// One row per user, created in the same transaction as the user. Split from
/// `users` so the hot auth path never carries settings columns it does not read.
model UserSettings {
  userId               String  @id @map("user_id") @db.Uuid
  darkMode             Boolean @default(false) @map("dark_mode")
  dailyGoal            Int     @default(20) @map("daily_goal")
  newCardsPerDay       Int     @default(10) @map("new_cards_per_day")
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")
  typoTolerance        Boolean @default(true) @map("typo_tolerance")
  /// "fixed" | "proportional" — see shared BlankWidthMode.
  blankWidthMode       String  @default("fixed") @map("blank_width_mode")
  /// IANA zone. Streak day boundaries are computed in the user's own timezone
  /// (plan §2.3), so this is load-bearing, not cosmetic.
  timezone             String  @default("UTC")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// Refresh tokens are stored as a SHA-256 hash, never in plaintext. A dump of
/// this table must not let the reader mint sessions.
///
/// `familyId` implements rotation with reuse detection: each refresh issues a
/// new token in the same family and revokes the old one. Presenting an already
/// revoked token means it leaked, so the whole family is killed at once.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "idx_refresh_user")
  @@index([familyId], map: "idx_refresh_family")
  @@map("refresh_tokens")
}

/// Reset tokens are hashed for the same reason as refresh tokens: read access
/// to this table would otherwise be read access to every account.
///
/// Single-use is enforced by `usedAt`, not by deletion, so a second attempt can
/// be distinguished from an expired one.
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "idx_reset_user")
  @@map("password_resets")
}

/// A user's folder of cards.
///
/// `archivedAt` rather than a boolean: archive is reversible and the timestamp
/// is worth keeping ("archived 3 months ago" is a useful sort), whereas delete
/// is not reversible and removes the row outright.
///
/// `color` is a plain string here, not an enum. The closed list lives in shared
/// `SET_COLORS` and is enforced by Zod at the edge; a Postgres enum would make
/// adding a ninth colour a migration rather than a one-line constant change.
model StudySet {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  description String?
  color       String    @default("slate")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards StudyCard[]

  /// Matches the sets-list query: scoped by owner, most recently touched first.
  @@index([userId, updatedAt(sort: Desc)], map: "idx_sets_user")
  @@map("study_sets")
}

/// A paragraph plus the highlights over it.
///
/// The paragraph is the immutable source of truth (plan §2.1) and is stored
/// NFC-normalised on write. No blanked/rendered form is persisted — `renderCloze`
/// derives it, so editing a highlight stays non-destructive.
///
/// `tags` is a `TEXT[]` column rather than a join table: v1 only ever reads all
/// of a card's tags at once and filters with `&&`/`@>`, which the GIN index
/// serves directly. A tags table would add two joins to every card read for a
/// feature that has no per-tag rows of its own.
model StudyCard {
  id         String   @id @default(uuid()) @db.Uuid
  studySetId String   @map("study_set_id") @db.Uuid
  title      String
  paragraph  String
  tags       String[] @default([])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  set     StudySet     @relation(fields: [studySetId], references: [id], onDelete: Cascade)
  answers CardAnswer[]

  @@index([studySetId, createdAt(sort: Desc)], map: "idx_cards_set")
  /// GIN, not btree: btree cannot answer `tags && '{anatomy}'`. Declared here so
  /// Prisma owns it and `migrate diff` does not report it as drift.
  @@index([tags(ops: ArrayOps)], map: "idx_cards_tags", type: Gin)
  @@map("study_cards")
}

/// One highlight: a code-point range into its card's paragraph.
///
/// Offsets are **Unicode code points**, not UTF-16 units — see
/// `shared/src/cloze/codepoints.ts`. `startOffset` is inclusive, `endOffset`
/// exclusive.
///
/// `answerText` is denormalised on purpose (plan §2.1): it is the validation
/// payload *and* a corruption tripwire, since `answerText` must always equal
/// `[...paragraph].slice(start, end).join('')`. A mismatch means a paragraph was
/// edited without re-anchoring. The server always recomputes it from the offsets
/// rather than trusting a client-supplied value, or the tripwire would be
/// comparing client data against client data.
model CardAnswer {
  id          String   @id @default(uuid()) @db.Uuid
  cardId      String   @map("card_id") @db.Uuid
  startOffset Int      @map("start_offset")
  endOffset   Int      @map("end_offset")
  answerText  String   @map("answer_text")
  altAnswers  String[] @default([]) @map("alt_answers")
  /// 0-based, ordered by `startOffset`. Stored rather than derived so a blank's
  /// identity is stable for review history across re-renders.
  ordinal     Int

  card StudyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  /// `idx_answers_card` from plan §2.3, made UNIQUE rather than a plain index.
  /// The columns a uniqueness constraint needs are exactly the ones the plan
  /// wanted indexed, so this is one btree doing both jobs instead of two doing
  /// one each. The uniqueness matters: without it two answers can both claim
  /// blank 0 and the graded result depends on row order.
  @@unique([cardId, ordinal], map: "idx_answers_card")
  @@map("card_answers")
}
