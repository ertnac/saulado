// Phase 2 adds auth. Phase 3 adds sets/cards/answers per IMPLEMENTATION_PLAN.md
// §2.3. Phase 4 adds the scheduling tables (§2.2) and the session tables that
// make a review resumable.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // btree_gist backs the no-overlapping-answers EXCLUDE constraint added by raw
  // SQL in the sets/cards migration; it lets one constraint mix `card_id WITH =`
  // (btree semantics) and a range `WITH &&` (gist semantics).
  extensions = [citext, btree_gist]
}

model HealthCheck {
  id        String   @id @default(uuid()) @db.Uuid
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("health_checks")
}

/// Email is CITEXT so uniqueness is case-insensitive in the database itself.
/// Normalising in application code alone is not enough: two concurrent
/// registrations can both pass a SELECT-then-INSERT check and produce
/// `A@x.com` and `a@x.com` as separate accounts. The constraint is the control.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.Citext
  passwordHash    String?   @map("password_hash")
  googleId        String?   @unique @map("google_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  emailVerifiedAt DateTime? @map("email_verified_at")

  settings       UserSettings?
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  emailChanges   EmailChange[]
  studySets      StudySet[]
  schedules      CardSchedule[]
  reviews        Review[]
  dailyStats     UserDailyStats[]
  studySessions  StudySession[]
  cloudFiles     CloudFile[]

  @@map("users")
}

/// One row per user, created in the same transaction as the user. Split from
/// `users` so the hot auth path never carries settings columns it does not read.
model UserSettings {
  userId               String  @id @map("user_id") @db.Uuid
  darkMode             Boolean @default(false) @map("dark_mode")
  dailyGoal            Int     @default(20) @map("daily_goal")
  newCardsPerDay       Int     @default(10) @map("new_cards_per_day")
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")
  typoTolerance        Boolean @default(true) @map("typo_tolerance")
  /// "fixed" | "proportional" — see shared BlankWidthMode.
  blankWidthMode       String  @default("fixed") @map("blank_width_mode")
  /// IANA zone. Streak day boundaries are computed in the user's own timezone
  /// (plan §2.3), so this is load-bearing, not cosmetic.
  timezone             String  @default("UTC")
  nickname             String  @default("")
  profileImage         String? @map("profile_image")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// Refresh tokens are stored as a SHA-256 hash, never in plaintext. A dump of
/// this table must not let the reader mint sessions.
///
/// `familyId` implements rotation with reuse detection: each refresh issues a
/// new token in the same family and revokes the old one. Presenting an already
/// revoked token means it leaked, so the whole family is killed at once.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "idx_refresh_user")
  @@index([familyId], map: "idx_refresh_family")
  @@map("refresh_tokens")
}

/// Reset tokens are hashed for the same reason as refresh tokens: read access
/// to this table would otherwise be read access to every account.
///
/// Single-use is enforced by `usedAt`, not by deletion, so a second attempt can
/// be distinguished from an expired one.
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "idx_reset_user")
  @@map("password_resets")
}

/// A requested-but-not-yet-applied email change (plan §6.5).
///
/// The new address lives here rather than on `users` until the link mailed to it
/// is clicked. That ordering is what makes a typo survivable: the account keeps
/// working on the old address until someone proves they can read the new one.
/// Writing it straight to `users` would hand the account to whoever owns the
/// mistyped mailbox, with no way back in.
///
/// `newEmail` is not unique here. Two people may both have a pending change to
/// the same address — only one can confirm it, and the `users.email` constraint
/// is what arbitrates, at the moment it actually matters.
model EmailChange {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  newEmail  String    @map("new_email") @db.Citext
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "idx_email_change_user")
  @@map("email_changes")
}

/// A user's folder of cards, and of other sets.
///
/// `archivedAt` rather than a boolean: archive is reversible and the timestamp
/// is worth keeping ("archived 3 months ago" is a useful sort), whereas delete
/// is not reversible and removes the row outright.
///
/// `color` is a plain string here, not an enum. The closed list lives in shared
/// `SET_COLORS` and is enforced by Zod at the edge; a Postgres enum would make
/// adding a ninth colour a migration rather than a one-line constant change.
///
/// `parentId` makes this an **adjacency list**: one nullable self-FK, null at the
/// root. Materialized paths and closure tables buy fast unbounded-depth queries,
/// which this schema does not need — depth is capped at shared `SET_DEPTH_MAX`
/// and a user has tens of sets, so `routes/set-tree.ts` loads `{id, parentId}`
/// once and walks the subtree in memory rather than issuing a recursive CTE.
///
/// The cascade is deliberate and it is the destructive edge of this model:
/// deleting a set takes its descendants, and their cards with them. It matches
/// what deleting a set already did to its own cards, and the confirm dialog in
/// `SetsPage` is responsible for saying so before the request is sent.
model StudySet {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  parentId   String?   @map("parent_id") @db.Uuid
  title      String
  color      String    @default("slate")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// A self-relation needs a name — Prisma cannot infer which side is which.
  parent   StudySet?      @relation("SetTree", fields: [parentId], references: [id], onDelete: Cascade)
  children StudySet[]     @relation("SetTree")
  cards    StudyCard[]
  sessions StudySession[]

  /// Matches the sets-list query: scoped by owner, most recently touched first.
  @@index([userId, updatedAt(sort: Desc)], map: "idx_sets_user")
  /// Matches the same query once it filters by level: `?parent=` absent means
  /// roots (`parent_id IS NULL`), a uuid means that set's children.
  @@index([userId, parentId, updatedAt(sort: Desc)], map: "idx_sets_parent")
  @@map("study_sets")
}

/// A paragraph plus the highlights over it.
///
/// The paragraph is the immutable source of truth (plan §2.1) and is stored
/// NFC-normalised on write. No blanked/rendered form is persisted — `renderCloze`
/// derives it, so editing a highlight stays non-destructive.
///
/// A card has no title. The paragraph *is* the card, and every list that used to
/// show a title now derives one with shared `cardLabel()`.
///
/// `tags` is a `TEXT[]` column rather than a join table: v1 only ever reads all
/// of a card's tags at once and filters with `&&`/`@>`, which the GIN index
/// serves directly. A tags table would add two joins to every card read for a
/// feature that has no per-tag rows of its own.
///
/// `search_vector` is a **generated** column, maintained by Postgres rather than
/// by application code (plan §6.1). Prisma cannot express `GENERATED ALWAYS AS`,
/// so it is declared `Unsupported` here and created in the
/// `20260808104500_search_vector` migration, then rebuilt without `title` by
/// `20260808153000_nested_sets_drop_title_description`. Current definition:
///
/// ```sql
/// ALTER TABLE "study_cards"
///   ADD COLUMN "search_vector" tsvector
///   GENERATED ALWAYS AS (
///     setweight(to_tsvector('english', coalesce("paragraph", '')), 'A')
///   ) STORED;
/// CREATE INDEX "idx_cards_search" ON "study_cards" USING GIN ("search_vector");
/// ```
///
/// `setweight` survives the loss of the second term on purpose: it pins the rank
/// scale, so adding another weighted field later cannot silently reorder every
/// existing result the way dropping and re-adding it would.
model StudyCard {
  id         String   @id @default(uuid()) @db.Uuid
  studySetId String   @map("study_set_id") @db.Uuid
  paragraph  String
  tags       String[] @default([])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  /// Never written by the application — Postgres computes it. Prisma Client
  /// does not expose `Unsupported` fields at all, which is exactly the
  /// behaviour a generated column needs: it is omitted from every INSERT and
  /// UPDATE the ORM builds, so no `create` call can fail by trying to set it.
  /// Reads go through `$queryRaw` in `routes/search.ts`.
  searchVector Unsupported("tsvector")? @map("search_vector")

  set          StudySet            @relation(fields: [studySetId], references: [id], onDelete: Cascade)
  answers      CardAnswer[]
  schedules    CardSchedule[]
  reviews      Review[]
  sessionCards StudySessionCard[]

  @@index([studySetId, createdAt(sort: Desc)], map: "idx_cards_set")
  /// GIN, not btree: btree cannot answer `tags && '{anatomy}'`. Declared here so
  /// Prisma owns it and `migrate diff` does not report it as drift.
  @@index([tags(ops: ArrayOps)], map: "idx_cards_tags", type: Gin)
  @@map("study_cards")
}

/// One highlight: a code-point range into its card's paragraph.
///
/// Offsets are **Unicode code points**, not UTF-16 units — see
/// `shared/src/cloze/codepoints.ts`. `startOffset` is inclusive, `endOffset`
/// exclusive.
///
/// `answerText` is denormalised on purpose (plan §2.1): it is the validation
/// payload *and* a corruption tripwire, since `answerText` must always equal
/// `[...paragraph].slice(start, end).join('')`. A mismatch means a paragraph was
/// edited without re-anchoring. The server always recomputes it from the offsets
/// rather than trusting a client-supplied value, or the tripwire would be
/// comparing client data against client data.
model CardAnswer {
  id          String   @id @default(uuid()) @db.Uuid
  cardId      String   @map("card_id") @db.Uuid
  startOffset Int      @map("start_offset")
  endOffset   Int      @map("end_offset")
  answerText  String   @map("answer_text")
  altAnswers  String[] @default([]) @map("alt_answers")
  /// 0-based, ordered by `startOffset`. Stored rather than derived so a blank's
  /// identity is stable for review history across re-renders.
  ordinal     Int

  card StudyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  /// `idx_answers_card` from plan §2.3, made UNIQUE rather than a plain index.
  /// The columns a uniqueness constraint needs are exactly the ones the plan
  /// wanted indexed, so this is one btree doing both jobs instead of two doing
  /// one each. The uniqueness matters: without it two answers can both claim
  /// blank 0 and the graded result depends on row order.
  @@unique([cardId, ordinal], map: "idx_answers_card")
  @@map("card_answers")
}

/// A card's scheduling state: one hot row per (user, card).
///
/// Split from `reviews` on purpose (plan §2.2). This table answers the only
/// question the study loop asks — "what is due?" — and `idx_schedules_due`
/// serves it as an index-only range scan. `CLAUDE.md` puts `next_review` on the
/// review rows instead, which turns that question into "the newest review per
/// card, then filter", a correlated subquery over a table that grows without
/// bound. Two tables because they have opposite access patterns: this one is
/// read and overwritten constantly, `reviews` is append-only and never read on
/// the hot path.
///
/// `dueAt` is a `DATE`, not a timestamp. A card is due *on a day* in the user's
/// own timezone; storing an instant would make "due today" depend on the hour
/// the last review happened to land on.
///
/// The row is created on first review, not with the card — absence is what marks
/// a card as new, so no backfill is needed when a card is created.
model CardSchedule {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  cardId       String   @map("card_id") @db.Uuid
  easeFactor   Decimal  @default(2.50) @map("ease_factor") @db.Decimal(3, 2)
  intervalDays Int      @default(0) @map("interval_days")
  repetitions  Int      @default(0)
  /// Incremented on every `again`. At `LEECH_THRESHOLD` (8) the card is a leech
  /// and is surfaced so the user can rewrite it rather than keep failing it.
  lapses       Int      @default(0)
  dueAt        DateTime @map("due_at") @db.Date
  lastReviewedAt DateTime? @map("last_reviewed_at")

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card StudyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  /// One schedule per user per card. Without this constraint a race between two
  /// tabs submitting the same card creates two schedules, and which one wins
  /// "what is due" depends on row order.
  @@unique([userId, cardId], map: "idx_schedules_user_card")
  /// The queue query, exactly: `WHERE user_id = $1 AND due_at <= $2 ORDER BY due_at`.
  @@index([userId, dueAt], map: "idx_schedules_due")
  @@map("card_schedules")
}

/// The append-only review log. Never read to build a queue.
///
/// Everything in `user_daily_stats` is derivable from this table, which is what
/// makes that rollup safe to keep: if it ever drifts, it can be rebuilt from
/// here. Nothing else in the system has that property, so nothing else may be
/// the only copy of a fact.
///
/// `grade` is a `SMALLINT` — 0 again, 1 hard, 2 good, 3 easy, ordered by how
/// well the card went so `AVG(grade)` means something. The mapping lives in
/// shared `GRADE_CODES` and nowhere else.
model Review {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  cardId String @map("card_id") @db.Uuid
  grade  Int    @db.SmallInt
  /// `[{ ordinal, submitted, correct, matchType, canonical }]`. JSONB rather
  /// than a fourth table (plan §2.2): v1 only ever reads a review's blanks all
  /// at once. Promote it if per-blank querying becomes a real need.
  blankResults Json     @map("blank_results")
  durationMs   Int?     @map("duration_ms")
  reviewedAt   DateTime @default(now()) @map("reviewed_at")

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card StudyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt(sort: Desc)], map: "idx_reviews_user_date")
  @@index([cardId, reviewedAt(sort: Desc)], map: "idx_reviews_card")
  @@map("reviews")
}

/// A per-day rollup, written in the same transaction as each review.
///
/// A rollup, **not a source of truth** — see `reviews`. It exists because the
/// dashboard and the streak both need "reviews on day N" for the last few
/// months, and computing that by scanning the review log gets slower every day
/// the user keeps studying.
///
/// `day` is a `DATE` in the *user's* timezone (plan §2.3). Rolling up by UTC day
/// would break the streak for anyone who studies in the evening east of
/// Greenwich: their 21:00 session lands on tomorrow's row.
model UserDailyStats {
  userId       String   @map("user_id") @db.Uuid
  day          DateTime @db.Date
  reviewsCount Int      @default(0) @map("reviews_count")
  correctCount Int      @default(0) @map("correct_count")
  /// Snapshotted rather than compared against the current `daily_goal`: lowering
  /// the goal must not retroactively award days the user did not earn.
  goalMet      Boolean  @default(false) @map("goal_met")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([userId, day(sort: Desc)], map: "idx_daily_stats_user_day")
  @@map("user_daily_stats")
}

/// One sitting. Server-side so a refresh does not lose progress (plan §4.2).
///
/// Which source built a session's queue. See `shared/src/study/types.ts`.
enum SessionMode {
  spaced
  sequential
  shuffled
  retake

  @@map("session_mode")
}

/// The queue could have lived in the client — it is, after all, just a list. But
/// then closing the tab mid-review loses the ordering, the count, and any card
/// the user was part-way through; and a client that owns the queue is a client
/// that can reorder it to see the easy cards first. The server holds it, and
/// `GET /api/study/sessions/:id` returns whatever is left.
model StudySession {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  /// Null when studying across every set.
  studySetId  String?     @map("study_set_id") @db.Uuid
  mode        SessionMode @default(spaced)
  startedAt   DateTime    @default(now()) @map("started_at")
  completedAt DateTime?   @map("completed_at")

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  set   StudySet?          @relation(fields: [studySetId], references: [id], onDelete: Cascade)
  cards StudySessionCard[]

  /// Finds the user's resumable session: the newest one with no `completed_at`.
  @@index([userId, startedAt(sort: Desc)], map: "idx_sessions_user")
  @@map("study_sessions")
}

/// A card's slot in one session's queue.
///
/// `position` is mutable: a card graded `again` is moved further back rather than
/// re-inserted, so the denominator of `7 / 24` never changes mid-session.
/// `answeredAt` is set only on final disposition, which is what keeps the
/// numerator monotonic — a re-queued card is not counted until it is done with.
///
/// `lastResult` is the idempotency payload, not a record. A double-tap on a phone
/// must not book two reviews for one recall, so a replayed `idempotencyKey`
/// returns this verbatim and writes nothing. It is session-scoped and disposable;
/// `reviews` remains the durable account of what happened.
model StudySessionCard {
  id        String  @id @default(uuid()) @db.Uuid
  sessionId String  @map("session_id") @db.Uuid
  cardId    String  @map("card_id") @db.Uuid
  position  Int
  /// No schedule row existed when the queue was built.
  isNew     Boolean @default(false) @map("is_new")
  attempts  Int     @default(0)
  answeredAt DateTime? @map("answered_at")
  grade      Int?      @db.SmallInt
  correct    Boolean?
  /// At least one blank was submitted empty — the retake trigger.
  hadEmptyBlank Boolean @default(false) @map("had_empty_blank")
  idempotencyKey String? @map("idempotency_key")
  lastResult     Json?   @map("last_result")

  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  card    StudyCard    @relation(fields: [cardId], references: [id], onDelete: Cascade)

  /// A card appears once per session. Re-queueing moves the row; it does not
  /// add one, or the same card could be scheduled twice from one sitting.
  @@unique([sessionId, cardId], map: "idx_session_cards_unique")
  /// The queue read: unanswered rows for a session, in order.
  @@index([sessionId, position], map: "idx_session_cards_order")
  @@map("study_session_cards")
}

model CloudFile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  fileType  String   @map("file_type")
  mimeType  String   @map("mime_type")
  fileSize  Int      @map("file_size")
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)], map: "idx_cloud_files_user")
  @@map("cloud_files")
}
